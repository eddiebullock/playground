# ---------------------------------------------------------------------------
# Paper v2 exceptions
# Parent ignore files hide the tables this paper needs:
#   bullpy/.gitignore  -> *.json, *.csv
#   repo-root .gitignore -> *.csv, *.png, *.pdf
# Re-include only small analysis artifacts (< ~5 MB). Never un-ignore stimuli,
# raw videos, model weights, or activation tensors.
# ---------------------------------------------------------------------------
!research/
!research/**
!research/figures/**
!research/paper/**

!data/eu_emotions_human_entropy.json
!data/human_confusion_meta.json
!data/human_confused_pairs.json
!data/eu_emotions_full_manifest.json
!data/eu_emotion_definitions.json
!data/eu_emotion_states_list.txt
!data/eu_emotion_synonyms.json

!results/mech/*.json
!results/mech/*.csv
!results/mech/axis_*.npy
!results/mech/pilot_n36/
!results/mech/pilot_n36/**

!results/stats/*.json
!results/stats/*.csv
!results/stats/*.md

!results/baseline/eu_emotions/qwen3vl/eval_v2_eu_emotions_qwen3vl_video_only_seed42.json
!results/baseline/eu_emotions/gemma4/eval_v2_eu_emotions_gemma4_video_only_seed42.json
!results/baseline/eu_emotions/molmo2/eval_v2_eu_emotions_molmo2_video_only_seed42.json

!results/figures/study3/*.png
!results/figures/study3/*.pdf
!results/README.md

# Keep log bodies out of git; .gitkeep so the directory exists
research/logs/*
!research/logs/.gitkeep

# Snoek AU + emotion raw data (CC BY 4.0, re-download via DOI 10.21942/uva.21261885)
data/external/snoek_au/

# CREMA-D raw ratings (ODbL/DbCL, re-download per research/CREMA_D_PLAN.md); no videos on this machine
data/external/crema_d/

# `datasets/` above is meant for data, but it also hid this source package
!src/paper_v2/datasets/
!src/paper_v2/datasets/*.py
